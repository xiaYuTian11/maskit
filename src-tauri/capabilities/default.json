{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "http:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "updater:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://127.0.0.1:5801/**" },
        { "url": "http://127.0.0.1:5802/**" },
        { "url": "http://127.0.0.1:5803/**" },
        { "url": "http://127.0.0.1:5804/**" },
        { "url": "http://127.0.0.1:5805/**" },
        { "url": "https://api.github.com/repos/xiaYuTian11/maskit/**" }
      ]
    }
  ]
}