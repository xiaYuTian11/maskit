{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Maskit",
  "mainBinaryName": "Maskit",
  "version": "0.8.0",
  "identifier": "com.maskit.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Data Maskit",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5801 http://127.0.0.1:5802 http://127.0.0.1:5803 http://127.0.0.1:5804 http://127.0.0.1:5805"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "100% 本地大模型敏感信息脱敏与还原网关",
    "longDescription": "Data Maskit 是专为大模型打造的本地隐私脱敏与还原网关，本地自动打码成业务占位符后转发上游，流式无感还原。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2",
          "libssl3 | libssl1.1"
        ],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": [
      "resources/engine/"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NUNGMDc5OTdFQkIwQTIKUldTaXNPdVhlZkJjdGFsK2h5d09rcTZaaXRQL1I4V09XdVVLU0tPZDNzRGh2cGV5cUZ4c2hLcDkK",
      "endpoints": [
        "https://github.com/xiaYuTian11/maskit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}